<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Keep direct access working for existing files and folders.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Send SPA routes to the Vue entry point.
  RewriteRule ^ index.html [L]
</IfModule>
